{
	"name": "webext-dynamic-content-scripts",
	"version": "10.0.4",
	"description": "WebExtension module: Automatically registers your `content_scripts` on domains added via `permission.request`",
	"license": "MIT",
	"repository": "fregante/webext-dynamic-content-scripts",
	"funding": "https://github.com/sponsors/fregante",
	"author": "Federico Brigante <me@fregante.com> (https://fregante.com)",
	"type": "module",
	"exports": {
		".": {
			"types": "./distribution/index.d.ts",
			"default": "./distribution/index.js"
		},
		"./utils": {
			"types": "./distribution/utils.d.ts",
			"default": "./distribution/utils.js"
		}
	},
	"sideEffects": [
		"./distribution/index.js"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsc",
		"demo:build": "parcel build --no-cache",
		"demo:watch": "parcel watch --no-cache --no-hmr",
		"prejest": "npm run demo:build",
		"jest": "npm run jest:core",
		"test:unit": "node --experimental-test-module-mocks --import ./setup-tests.js --test \"source/*.test.ts\"",
		"jest:core": "NODE_OPTIONS=--experimental-vm-modules JEST_PUPPETEER_CONFIG=jest-puppeteer.config.cjs jest",
		"prepare": "tsc --sourceMap false",
		"lint": "xo",
		"fix": "xo --fix",
		"test": "run-p lint test:unit jest",
		"watch": "tsc --watch"
	},
	"files": [
		"distribution",
		"!distribution/*.test.*"
	],
	"keywords": [
		"contentscript",
		"register",
		"injection",
		"permissions",
		"request",
		"optional_permissions",
		"manifest",
		"new hosts",
		"chrome",
		"firefox",
		"browser",
		"extension"
	],
	"dependencies": {
		"webext-content-scripts": "^3.0.0",
		"webext-detect": "^6.0.0",
		"webext-events": "^4.0.0",
		"webext-patterns": "^3.0.0",
		"webext-permissions": "^6.0.0",
		"webext-tools": "^4.1.2"
	},
	"devDependencies": {
		"@parcel/config-webextension": "^2.16.4",
		"@sindresorhus/tsconfig": "^8.1.0",
		"@types/chrome": "^0.3.6",
		"@types/node": "^24.19.2",
		"expect-puppeteer": "^11.0.0",
		"globals": "^17.13.0",
		"jest": "^30.5.2",
		"jest-puppeteer": "^11.0.0",
		"npm-run-all2": "^9.0.4",
		"parcel": "^2.16.4",
		"puppeteer": "^25.15.0",
		"typescript": "^6.0.3",
		"xo": "^5.0.1"
	},
	"jest": {
		"preset": "jest-puppeteer",
		"testMatch": [
			"**/test/*.js"
		]
	},
	"@parcel/resolver-default": {
		"packageExports": true
	},
	"targets": {
		"main": false,
		"module": false,
		"demo": {
			"source": "./test/demo-extension/manifest.json",
			"engines": {
				"browsers": "last 1 chrome version"
			},
			"distDir": "./test/dist",
			"sourceMap": {
				"inline": true
			},
			"optimize": false
		}
	},
	"webExt": {
		"sourceDir": "test/dist",
		"run": {
			"startUrl": [
				"https://static-ephiframe.vercel.app/Static",
				"https://static-ephiframe.vercel.app/Static?iframe=./Inner",
				"https://dynamic-ephiframe.vercel.app/Dynamic",
				"https://dynamic-ephiframe.vercel.app/Dynamic?iframe=./Inner",
				"https://dynamic-ephiframe.vercel.app/Dynamic?iframe=https://static-ephiframe.vercel.app/Static-inner",
				"https://static-ephiframe.vercel.app/Static?iframe=https://dynamic-ephiframe.vercel.app/Dynamic-inner",
				"chrome://extensions/"
			]
		}
	}
}
